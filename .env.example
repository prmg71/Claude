# =============================================================================
# Configuração local — copie para .env e ajuste
# =============================================================================

# --- Banco de dados ----------------------------------------------------------
# Padrão: SQLite local (app.db na raiz do projeto). Não precisa definir nada.
# Para usar PostgreSQL/Supabase, preencha com a URL do painel:
# Settings → Database → Connection string → URI
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.<ref>.supabase.co:5432/postgres

# --- Autenticação ------------------------------------------------------------
# DEV_MODE=true bypassa o Supabase Auth: todas as requisições viram curador local.
# Nunca use em produção.
# DEV_MODE=true

# Supabase Auth (Settings → API):
SUPABASE_URL=https://<ref>.supabase.co
SUPABASE_ANON_KEY=<anon-public-key>
CURADOR_EMAILS=voce@exemplo.com,outro@exemplo.com

# --- LLM ---------------------------------------------------------------------
# Provedor padrão do fork local: endpoint compatível com API OpenAI.
LLM_PROVIDER=openai_compat

# URL base do endpoint (exemplos):
# Ollama local:          http://localhost:11434/v1
# LM Studio local:       http://localhost:1234/v1
# Qualquer outro:        https://seu-endpoint.exemplo.com/v1
LLM_BASE_URL=

# Chave de API (use qualquer string se o endpoint não exigir autenticação real).
LLM_API_KEY=

# Nome do modelo conforme listado pelo endpoint.
LLM_MODEL=

# --- Limites de contexto (opcional) -----------------------------------------
# MAX_CHARS_CONTRATO=120000
# MAX_CHARS_REFERENCIAS=60000
# MAX_CHARS_CONHECIMENTO=40000
